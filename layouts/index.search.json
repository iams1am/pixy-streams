{{- /* Flat index for the header search box: titles, fixtures, meta lines, genres. */ -}}
{{- $entries := slice -}}

{{- range where site.RegularPages "Type" "catalog" -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" .RelPermalink
    "meta" (.Params.meta | default "")
    "kind" (.Params.catalog | default "")
    "genres" (.Params.genres | default slice)) -}}
{{- end -}}

{{- range where site.RegularPages "Type" "watch" -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" .RelPermalink
    "meta" (printf "%s · %s min · Free to watch" (string .Params.year) (string .Params.runtime))
    "kind" "sample"
    "genres" (.Params.genres | default slice)) -}}
{{- end -}}

{{- with site.Data.catalog.sports -}}
  {{- range $event := .items -}}
    {{- with $event.slug -}}
      {{- $entries = $entries | append (dict
        "title" $event.title
        "url" (partial "link.html" (printf "/sports/%s/" .))
        "meta" ($event.meta | default "")
        "kind" "event"
        "genres" ($event.genres | default slice)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $entries | jsonify -}}
