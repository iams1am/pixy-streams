{{ $catalog := site.Data.catalog.anime }}
{{ if and $catalog $catalog.items }}
{{ range $index, $item := $catalog.items }}
{{ $.AddPage (dict
  "path" $item.slug
  "title" $item.title
  "type" "catalog"
  "params" (dict
    "catalog_id" $item.id
    "genres" $item.genres
    "catalog" "anime"
    "source" $item.source
    "source_url" $item.source_url
    "overview" $item.overview
    "poster" $item.poster
    "backdrop" $item.backdrop
    "accent" $item.accent
    "score" $item.score
    "meta" $item.meta
    "year" $item.year
    "status" $item.status
    "format" $item.format
    "episodes" $item.episodes
    "original_title" $item.original_title
    "trailer" $item.trailer
    "watch" $item.watch
    "weight" $index
  )
) }}
{{ end }}
{{ end }}
