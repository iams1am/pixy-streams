{{ $catalog := site.Data.catalog.series }}
{{ if and $catalog $catalog.items }}
{{ range $index, $item := $catalog.items }}
{{ $.AddPage (dict
  "path" $item.slug
  "title" $item.title
  "type" "catalog"
  "params" (dict
    "genres" $item.genres
    "catalog" "series"
    "source" $item.source
    "source_url" $item.source_url
    "overview" $item.overview
    "poster" $item.poster
    "backdrop" $item.backdrop
    "accent" $item.accent
    "score" $item.score
    "meta" $item.meta
    "year" $item.year
    "first_air_date" $item.first_air_date
    "last_air_date" $item.last_air_date
    "runtime" $item.runtime
    "original_title" $item.original_title
    "trailer" $item.trailer
    "watch" $item.watch
    "watch_attribution" $item.watch_attribution
    "status" $item.status
    "number_of_seasons" $item.number_of_seasons
    "number_of_episodes" $item.number_of_episodes
    "seasons" $item.seasons
    "weight" $index
  )
) }}
{{ end }}
{{ end }}
