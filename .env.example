# Copy to .env and fill in. .env is git-ignored; only this example is committed.
# The catalogue script reads these at build time, and the shell overrides this file.

# TMDB (https://www.themoviedb.org/settings/api) - unlocks live movie and TV
# posters, backdrops, trailers, runtime and watch providers. Either the v3 key or
# the v4 read token works. TMDB_REGION is an ISO 3166-1 code for watch availability.
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_REGION=US

# TheSportsDB fallback for fixtures. The public test key is rate-limited.
SPORTSDB_KEY=123
